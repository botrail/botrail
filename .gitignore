# Rust
target/

# Node
node_modules/
studio/dist/
studio/dist-wasm/
# generated by wasm-pack (scripts/build_wasm_demo.sh)
studio/public-wasm/

# Generated usd
/*.usd
/*.usd[ac]
/**/*.usd
/**/*.usd[ac]
examples/**/*.usd
examples/**/*.usd[ac]
!examples/assets/*.usd
!examples/assets/*.usd[ac]
# the GTP station demo's props (examples/legged/_gtp_station.py)
!examples/assets/gtp_station/**/*.usd[ac]
!python/tests/**/*.usd[ac]
# the vendored shape library (scripts/sync_shapes.py): tracked, and maturin
# applies this file to the wheel too, so an ignored .usda would ship nowhere
!python/botrail/_shapes/*.usda

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
# built studio assets bundled into the python package (generated by
# scripts/build_studio.sh); [tool.maturin] include in pyproject.toml puts them
# back into the wheel, which otherwise honours this file
python/botrail/_studio/

*.so

# Docs (mkdocs build output)
site/

# Pivate docs
.internal/
tmp/

# Editors
.vscode/
.idea/

# Demo outputs written next to the demos / into the working directory
examples/**/*_deliverables/
examples/**/*_io.csv
/machining_cell.script
/machining_plate_cut.obj
/machining_plate_cut.mtl
